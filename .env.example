# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID через запятую, пусто = доступ всем (не рекомендуется)
TELEGRAM_ADMIN_IDS=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# --- Видео ---
# image = картинки + плавное движение (дёшево), flow = Veo через браузер по подписке,
# veo = видеогенерация через платный API, gradient = тест без затрат
VISUAL_MODE=image
ORIENTATION=vertical
# 1 сцена x 8 сек = ролик на ~10 секунд под один клип Flow
SCENES_COUNT=1
SCENE_SECONDS=8
CONTENT_LANGUAGE=ru
TTS_VOICE=Kore
SUBTITLES=true
# На Windows Arial, на Linux например "DejaVu Sans"
SUBTITLE_FONT=Arial
THUMBNAIL_ENABLED=true
MUSIC_PATH=
MUSIC_VOLUME=0.12
VEO_POLL_INTERVAL=15
VEO_TIMEOUT=900

# --- Flow через браузер (подписка Google AI Pro) ---
# Профили Chromium с живой сессией, по одному на аккаунт
FLOW_ACCOUNTS=acc1,acc2,acc3,acc4,acc5
FLOW_PROFILES_DIR=profiles
# Сколько генераций в сутки снимать с одного аккаунта
FLOW_DAILY_LIMIT=10
# Ссылка на проект Flow (можно вставить URL конкретного проекта)
FLOW_URL=https://labs.google/fx/tools/flow
# Headless Google палит, держи false
FLOW_HEADLESS=false
FLOW_TIMEOUT=420
FLOW_BLOCK_MINUTES=60
# Селекторы правятся без правки кода: python login_flow.py --acc acc1 --inspect
FLOW_PROMPT_SELECTOR=textarea
FLOW_SUBMIT_SELECTOR=
FLOW_VIDEO_PATTERN=\.mp4|video/mp4
FLOW_DEBUG=true
FLOW_DEBUG_DIR=logs/flow

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=24
YOUTUBE_PLAYLIST_ID=
YOUTUBE_MADE_FOR_KIDS=false

# --- Автопостинг ---
AUTO_ENABLED=false
AUTO_TIMES=10:00,19:00
AUTO_PRESET=ai_stories
AUTO_PRIVACY=private
AUTO_NOTIFY_CHAT_ID=

# --- Прочее ---
DATABASE_PATH=data/videobot.sqlite3
WORK_DIR=work
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
KEEP_WORKDIR=false
LOG_LEVEL=INFO
